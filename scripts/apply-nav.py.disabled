              <li><a href="programs.html#upcoming-events" class="footer-link">Events</a></li>
              <li><a href="programs.html#upcoming-conferences" class="footer-link">Conferences</a></li>
              <li><a href="programs.html#upcoming-workshops" class="footer-link">Workshops</a></li>"""

DROPDOWN_CSS = """
    .desktop-nav .dropdown-menu-desktop.dropdown-menu-opportunities { min-width: 440px; padding: 0.75rem 0.5rem; display: flex; gap: 0; }
    .desktop-nav .dropdown-menu-opportunities .dropdown-column { flex: 1; min-width: 0; }
    .desktop-nav .dropdown-menu-opportunities .dropdown-column + .dropdown-column { border-left: 1px solid rgba(255, 255, 255, 0.1); }"""

DETAIL_NAV_CSS = """
      .desktop-nav .nav-item { position: relative; }
      .desktop-nav .nav-link .dropdown-arrow { font-size: 8px; transition: transform 0.3s ease; margin-left: 4px; color: #ffffff; }
      .desktop-nav .nav-item.has-dropdown:hover .dropdown-arrow { transform: rotate(180deg); }
      .desktop-nav .dropdown-menu-desktop { position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(10px); min-width: 240px; background: rgba(30, 41, 59, 0.95); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 0.75rem 0; opacity: 0; visibility: hidden; transition: all 0.3s ease; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4); z-index: 1000; }
      .desktop-nav .nav-item.has-dropdown:hover .dropdown-menu-desktop { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
      .desktop-nav .dropdown-section-title { padding: 0.5rem 1.25rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #9CA3AF; }
      .desktop-nav .dropdown-item { display: block; padding: 0.6rem 1.25rem; color: #ffffff; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.2s ease; }
      .desktop-nav .dropdown-item:hover { background: rgba(255, 255, 255, 0.1); color: #ffffff; padding-left: 1.5rem; }"""

DESKTOP_NAV_BLOCK = f"""<nav class="desktop-nav">
          <div class="desktop-nav-container">
            <div class="nav-item"><a href="index.html" class="nav-link">Home</a></div>
            <div class="nav-item"><a href="about.html" class="nav-link">About</a></div>
            <div class="nav-item"><a href="mission-vision.html" class="nav-link">Mission & Vision</a></div>

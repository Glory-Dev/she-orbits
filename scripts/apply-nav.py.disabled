                    <li class="header-item"><a href="index.html" class="header-link hstack gap-2 fs-7 fw-bold text-dark"><img src="../assets/images/svgs/secondary-leaf.svg" alt="" width="20" height="20" class="img-fluid animate-spin">Home</a></li>
                    <li class="header-item"><a href="about.html" class="header-link hstack gap-2 fs-7 fw-bold text-dark"><img src="../assets/images/svgs/secondary-leaf.svg" alt="" width="20" height="20" class="img-fluid animate-spin">About</a></li>
                    <li class="header-item"><a href="mission-vision.html" class="header-link hstack gap-2 fs-7 fw-bold text-dark"><img src="../assets/images/svgs/secondary-leaf.svg" alt="" width="20" height="20" class="img-fluid animate-spin">Mission & Vision</a></li>
                    <li class="header-item">
                      <a href="programs.html" class="header-link hstack gap-2 fs-7 fw-bold text-dark has-submenu" onclick="toggleSubmenu(event)"><img src="../assets/images/svgs/secondary-leaf.svg" alt="" width="20" height="20" class="img-fluid animate-spin">Opportunities</a>
                      """ + MOBILE_SUBMENU + """
                    </li>
                    <li class="header-item"><a href="sectors.html" class="header-link hstack gap-2 fs-7 fw-bold text-dark"><img src="../assets/images/svgs/secondary-leaf.svg" alt="" width="20" height="20" class="img-fluid animate-spin">Sectors</a></li>
                    <li class="header-item"><a href="contact.html" class="header-link hstack gap-2 fs-7 fw-bold text-dark"><img src="../assets/images/svgs/secondary-leaf.svg" alt="" width="20" height="20" class="img-fluid animate-spin">Contact</a></li>
                  </ul>
                </div>
              </div>
            </ul>"""


def add_dropdown_css(text: str) -> str:
    if "dropdown-menu-opportunities" in text:
        return text
    marker = ".desktop-nav .dropdown-divider"
  if marker in text:
    insert = DROPDOWN_CSS + "\n    .desktop-nav .dropdown-divider { height: 1px; background: rgba(255, 255, 255, 0.1); margin: 0.5rem 1rem; }"
    if ".desktop-nav .dropdown-divider {" in text or "dropdown-menu-opportunities" in text:
      return text
    return text.replace(marker, marker + insert, 1)
    marker = ".desktop-nav .dropdown-item:hover"
    if marker in text:
        idx = text.find(marker)
        end = text.find("\n", idx)
        return text[: end + 1] + DROPDOWN_CSS + text[end + 1 :]
    return text


def replace_desktop_dropdown(text: str) -> str:
    pattern = re.compile(
        r"<div class=\"nav-item has-dropdown\">.*?<div class=\"dropdown-menu-desktop\">.*?</div>\s*</div>",
        re.DOTALL,
    )
    if not pattern.search(text):
        return text
    return pattern.sub(DESKTOP_DROPDOWN, text, count=1)


def replace_mobile_submenu(text: str) -> str:
    pattern = re.compile(
        r"<ul class=\"submenu list-unstyled ps-4 mt-2\">.*?</ul>",
        re.DOTALL,
    )
    if "Opportunities</a>" not in text and "Opportunities <span" not in text:
        return text
    return pattern.sub(MOBILE_SUBMENU, text, count=1)


def replace_footer(text: str) -> str:
    pattern = re.compile(
        r"<li><a href=\"#\" class=\"footer-link fw-bold\">Opportunities</a></li>.*?"
        r"(?:<li><a href=\"events\.html\" class=\"footer-link\">Events</a></li>|"
        r"<li><a href=\"internships\.html\" class=\"footer-link\">Internships</a></li>)",
        re.DOTALL,
    )
    if not pattern.search(text):
        return text
    return pattern.sub(FOOTER_OPPORTUNITIES, text, count=1)


def upgrade_detail_page(text: str) -> str:
    if "dropdown-menu-opportunities" in text:
        return text

    if ".desktop-nav .nav-cta" in text and ".desktop-nav .dropdown-menu-desktop" not in text:
        text = text.replace(
            ".desktop-nav .nav-cta { margin-left: 0.5rem;",
            DETAIL_NAV_CSS + DROPDOWN_CSS + "\n      .desktop-nav .nav-cta { margin-left: 0.5rem;",
            1,
        )

    text = re.sub(
        r"<nav class=\"desktop-nav\">.*?</nav>",
        DESKTOP_NAV_BLOCK,
        text,
        count=1,
        flags=re.DOTALL,
    )

    text = re.sub(
        r"<ul class=\"dropdown-menu dropdown-menu-end p-4\">.*?</ul>\s*</div>\s*</div>",
        MOBILE_NAV_BLOCK + "\n          </div>\n        </div>",
        text,
        count=1,
        flags=re.DOTALL,
    )

    if "function toggleSubmenu" not in text:
        text = text.replace(
            "</body>",
            "<script>\n  function toggleSubmenu(event) {\n    event.preventDefault();\n    event.stopPropagation();\n    const link = event.currentTarget;\n    const submenu = link.nextElementSibling;\n    if (submenu && submenu.classList.contains('submenu')) {\n      submenu.classList.toggle('show');\n      link.classList.toggle('show');\n    }\n  }\n</script>\n</body>",
        )

    if "has-submenu" not in text:
        submenu_css = """
    .has-submenu { cursor: pointer; position: relative; }
    .submenu { display: none; padding-left: 20px; margin-top: 10px; max-height: 300px; overflow-y: auto; border-left: 2px solid rgba(107, 114, 128, 0.2); }
    .submenu.show { display: block; }"""
        text = text.replace("</style>", submenu_css + "\n  </style>", 1)

    return text


def update_file(path: Path) -> bool:
    original = path.read_text()
    updated = original
    updated = add_dropdown_css(updated)
    updated = replace_desktop_dropdown(updated)
    updated = replace_mobile_submenu(updated)
    updated = replace_footer(updated)

    if path.name in {"programs.html", "program-detail.html", "sector-detail.html"}:
        updated = upgrade_detail_page(updated)

    if updated != original:
        path.write_text(updated)
        return True
    return False


def main() -> None:
    changed = []
    for path in sorted(HTML_DIR.glob("*.html")):
        if path.name == "404.html":
            continue
        if update_file(path):
            changed.append(path.name)
    print("Updated:", ", ".join(changed) if changed else "none")


if __name__ == "__main__":
    main()

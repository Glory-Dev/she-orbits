            <div class="nav-item"><a href="contact.html" class="nav-link nav-cta">Apply Now</a></div>
          </div>
        </nav>"""

MOBILE_NAV_BLOCK = """<ul class="dropdown-menu dropdown-menu-end p-4">
              <div class="d-flex flex-column gap-6">
                <div class="hstack justify-content-between border-bottom pb-6">

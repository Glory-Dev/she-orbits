---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  return (await getProjects()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<BaseLayout title={`SHE ORBITS - ${d.title}`} description={d.summary} bodyClass="page-projects page-project-detail" image={d.image}>
  <main class="project-detail">
    <a href="/projects/" class="project-back"><Icon name="lucide:chevron-left" /> All projects</a>
    <div class="project-detail-image"><img src={d.image} alt={d.title} /></div>
    {d.keywords.length > 0 && <ul class="project-keywords">{d.keywords.map((k) => <li>{k}</li>)}</ul>}
    <h1 class="project-detail-title">{d.title}</h1>
    <p class="project-detail-lead">{d.summary}</p>
    {entry.body?.trim() && <div class="detail-body project-detail-body"><Content /></div>}
    <div class="d-flex flex-wrap gap-3 mt-5">
      <a href="/projects/" class="btn border border-white border-opacity-25 text-white">All projects</a>
      <a href="/contact/" class="btn btn-primary text-white">Get involved</a>
    </div>
  </main>
</BaseLayout>

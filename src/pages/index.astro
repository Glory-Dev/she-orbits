---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import SectorCard from '../components/SectorCard.astro';
import ProgramCard from '../components/ProgramCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import Carousel from '../components/Carousel.astro';
import NewsCard from '../components/NewsCard.astro';
import { getSectors, getOpportunities, getNews, getProjects } from '../lib/content';
const sectors = await getSectors();
const news = (await getNews()).slice(0, 9);
const featuredProjects = (await getProjects()).slice(0, 12); // the first 12 by `order`; the rest live on /projects/
const upcoming = (await getOpportunities()).filter((o) => o.data.status === 'upcoming');
---
<BaseLayout title={"SHE ORBITS - Empowering Women in Space Industry"} description={""} bodyClass="page-home" fluidCursor>




  <!-- Updated Header with Logo -->

  

  <div class="page-wrapper overflow-hidden">

    <!-- Banner Section -->
    <PageBanner title={"SHE ORBITS"} video="/assets/images/backgrounds/banner-video.mp4" ctaHref="/contact/" ctaLabel="Apply now" padClass="pb-8" copyClass="banner-hero-copy">Pioneering <span class="text-primary">women's leadership in space exploration</span> through Aerospace, Space industry, Space exploration Innovation, education, and groundbreaking aerospace research.</PageBanner>

    <!-- Stats & Facts Section -->
    <section class="stats-facts py-5 py-lg-11 py-xl-12 position-relative overflow-hidden">
      <div class="container">
        <div class="row gap-7 gap-xl-0">
          <div class="col-xl-4 col-xxl-4">
            <div class="d-flex align-items-center gap-7 py-2" data-aos="fade-right" data-aos-delay="100"
              data-aos-duration="1000">
              <span
                class="round-36 flex-shrink-0 text-white rounded-circle bg-primary hstack justify-content-center fw-medium">01</span>
              <hr class="border-line">
              <span class="badge text-bg-dark">Why Choose Us</span>
            </div>
          </div>
          <div class="col-xl-8 col-xxl-7">
            <div class="d-flex flex-column gap-9">

                </div>
              </div>
              <a href="/about/" class="btn" data-aos="fade-up" data-aos-delay="500" data-aos-duration="1000">
                <span class="btn-text">Learn More About Our Mission</span>
                <Icon name="lucide:arrow-up-right" class="btn-icon bg-white text-dark round-52 rounded-circle hstack justify-content-center fs-7 shadow-sm" />
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="position-absolute bottom-0 start-0" data-aos="zoom-in" data-aos-delay="100" data-aos-duration="1000">
        <img src="/assets/images/backgrounds/stats-facts-bg.svg" alt="" class="img-fluid">
      </div>
    </section>

    <!-- SECTORS SHOWCASE SECTION -->

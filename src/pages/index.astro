                    data-aos-duration="1000">
                    <h2 class="mb-0 fs-14">50+</h2>
                    <p class="mb-0">Space Research Projects Completed</p>
                  </div>
                </div>
                <div class="col-md-6 col-lg-4">
                  <div class="d-flex flex-column gap-6 pt-9 border-top" data-aos="fade-up" data-aos-delay="400"
                    data-aos-duration="1000">
                    <h2 class="mb-0 fs-14">10+</h2>
                    <p class="mb-0">International Space Partnerships</p>
                  </div>
                </div>
                <div class="col-md-6 col-lg-4">

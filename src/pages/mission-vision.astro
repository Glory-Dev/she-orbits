---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
---
<BaseLayout title={"SHE ORBITS - Mission & Vision | Empowering Girls in Space"} description={""} bodyClass="page-mission-vision" fluidCursor>


  <!-- Header -->

  
  <!--  Page Wrapper -->
  <div class="page-wrapper overflow-hidden">

    <!--  Banner Section -->
    <PageBanner title={"Mission & Vision"} video="/assets/images/backgrounds/mission.mp4" leadOpacity="70">Charting the <span class="text-white">future of women in space</span> through purposeful innovation and global collaboration</PageBanner>

    <!-- Mission Statement Section -->
    <section class="mission-section py-5 py-lg-11 py-xl-12">
      <div class="container">
        <div class="row gap-7 gap-xl-0 mb-10">
          <div class="col-xl-4 col-xxl-4">
            <div class="d-flex align-items-center gap-7 py-2" data-aos="fade-right" data-aos-delay="100"
              data-aos-duration="1000">
              <span
                class="round-36 flex-shrink-0 text-dark rounded-circle bg-primary hstack justify-content-center fw-medium">01</span>
              <hr class="border-line">
              <span class="badge text-bg-dark">Our Purpose</span>
            </div>
          </div>
          <div class="col-xl-8 col-xxl-7">
            <div class="d-flex flex-column gap-6" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
              <h2 class="mb-0">Our Mission</h2>
            </div>
          </div>
        </div>

        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="mission-card" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
              <div class="text-center">
                <Icon name="lucide:target" class="fs-1 text-primary mb-4 d-block mx-auto" />
                <h3 class="mb-4">Empowering women in space industry</h3>
                <p class="fs-5 text-dark mb-4">
                  At SHE ORBITS, our mission is to bridge the gender gap in the global space ecosystem by empowering
                  women and girls through accessible, high-quality education, hands-on technical training, research
                  opportunities, mentorship, and international collaboration.
                </p>
                <p class="fs-5 text-dark mb-0">
                  We are committed to building an inclusive community where aspiring scientists, engineers, researchers,
                  entrepreneurs, and future astronauts can develop the knowledge, skills, and confidence needed to lead
                  innovation in the space sector. Through interdisciplinary learning, industry partnerships, and
                  real-world experiences, we create pathways that transform ambition into meaningful impact for both
                  Earth and space.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision Statement Section -->
    <section class="vision-section py-5 py-lg-11 py-xl-12 bg-light-gray">
      <div class="container">
        <div class="row gap-7 gap-xl-0 mb-10">
          <div class="col-xl-4 col-xxl-4">
            <div class="d-flex align-items-center gap-7 py-2" data-aos="fade-right" data-aos-delay="100"
              data-aos-duration="1000">
              <span
                class="round-36 flex-shrink-0 text-dark rounded-circle bg-primary hstack justify-content-center fw-medium">02</span>
              <hr class="border-line">
              <span class="badge text-bg-dark">Our Future</span>
            </div>
          </div>
          <div class="col-xl-8 col-xxl-7">
            <div class="d-flex flex-column gap-6" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
              <h2 class="mb-0">Our Vision</h2>
            </div>
          </div>
        </div>

        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="mission-card bg-white" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
              <div class="text-center">
                <Icon name="lucide:telescope" class="fs-1 text-primary mb-4 d-block mx-auto" />
                <h3 class="mb-4">A Universe of Equal Opportunities</h3>
                <p class="fs-5 text-dark mb-4">
                  We envision a future where women are equally represented at every level of the global space
                  industry—as pioneers, innovators, entrepreneurs, researchers, executives, and explorers.
                </p>
                <p class="fs-5 text-dark mb-0">
                  A world where barriers to opportunity no longer define who contributes to space exploration and
                  technological advancement. Through pioneering programs and initiatives, strategic partnerships,
                  research, education, and workforce development, SHE ORBITS strives to cultivate the next generation of
                  scientists, engineers, entrepreneurs, and industry leaders.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section class="values-section py-5 py-lg-11 py-xl-12">
      <div class="container">
        <div class="row gap-7 gap-xl-0 mb-10">
          <div class="col-xl-4 col-xxl-4">
            <div class="d-flex align-items-center gap-7 py-2" data-aos="fade-right" data-aos-delay="100"
              data-aos-duration="1000">
              <span
                class="round-36 flex-shrink-0 text-dark rounded-circle bg-primary hstack justify-content-center fw-medium">03</span>
              <hr class="border-line">
              <span class="badge text-bg-dark">Our Values</span>
            </div>
          </div>
          <div class="col-xl-8 col-xxl-7">
            <div class="d-flex flex-column gap-6" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
              <h2 class="mb-0">Core Values That Drive Us</h2>
              <p class="fs-5 mb-0 text-opacity-70">The principles that guide our company's mission to empower women and
                girls in space and STEM fields.</p>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
            <div class="value-card">
              <div class="value-icon">
                <Icon name="lucide:users" class="fs-3 text-primary" />
              </div>
              <h4 class="mb-3">Inclusion & Diversity</h4>
              <p class="text-dark text-opacity-70">We embrace diversity and ensure equal opportunities for all girls,
                regardless of their background, ethnicity, or economic status.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
            <div class="value-card">
              <div class="value-icon">
                <Icon name="lucide:rocket" class="fs-3 text-primary" />
              </div>
              <h4 class="mb-3">Innovation</h4>
              <p class="text-dark text-opacity-70">We foster creativity and encourage groundbreaking ideas that push the
                boundaries of what's possible in space exploration.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300" data-aos-duration="1000">
            <div class="value-card">
              <div class="value-icon">
                <Icon name="lucide:sparkles" class="fs-3 text-primary" />
              </div>
              <h4 class="mb-3">Empowerment</h4>
              <p class="text-dark text-opacity-70">We empower girls to become confident leaders and innovators in STEM
                fields through mentorship and hands-on experiences.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="400" data-aos-duration="1000">
            <div class="value-card">
              <div class="value-icon">
                <Icon name="lucide:heart-handshake" class="fs-3 text-primary" />
              </div>
              <h4 class="mb-3">Collaboration</h4>
              <p class="text-dark text-opacity-70">We build strong networks and partnerships globally to create
                opportunities for girls in the space industry.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="500" data-aos-duration="1000">
            <div class="value-card">
              <div class="value-icon">
                <Icon name="lucide:graduation-cap" class="fs-3 text-primary" />
              </div>
              <h4 class="mb-3">Excellence</h4>
              <p class="text-dark text-opacity-70">We strive for excellence in education and training, providing
                world-class programs and resources.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="600" data-aos-duration="1000">
            <div class="value-card">
              <div class="value-icon">
                <Icon name="lucide:globe" class="fs-3 text-primary" />
              </div>
              <h4 class="mb-3">Global Impact</h4>
              <p class="text-dark text-opacity-70">We work to create lasting positive change in communities worldwide
                through our programs and initiatives.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategic Roadmap Section -->
    <section class="goals-section py-5 py-lg-11 py-xl-12 bg-light-gray">
      <div class="container">
        <div class="row gap-7 gap-xl-0 mb-10">
          <div class="col-xl-4 col-xxl-4">
            <div class="d-flex align-items-center gap-7 py-2" data-aos="fade-right" data-aos-delay="100"
              data-aos-duration="1000">
              <span
                class="round-36 flex-shrink-0 text-dark rounded-circle bg-primary hstack justify-content-center fw-medium">04</span>
              <hr class="border-line">
              <span class="badge text-bg-dark">Our Goals</span>
            </div>
          </div>
          <div class="col-xl-8 col-xxl-7">
            <div class="d-flex flex-column gap-6" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
              <h2 class="mb-0">Strategic Roadmap 2025–2030</h2>
              <p class="fs-5 mb-0 text-opacity-70">Driving innovation, research, education, and international
                collaboration to shape the future of the global space industry.</p>
            </div>
          </div>
        </div>

        <div class="row mb-8">
          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
            <div class="timeline-item">
              <h4>Expand Global Impact</h4>
              <p class="text-dark text-opacity-70">Continue expanding SHE ORBITS' international presence through
                educational programs, research collaborations, and strategic partnerships, building a global community
                of future space leaders.</p>
            </div>
          </div>
          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="150" data-aos-duration="1000">
            <div class="timeline-item">
              <h4>Advance Research &amp; Innovation</h4>
              <p class="text-dark text-opacity-70">Lead interdisciplinary research in artificial intelligence,
                autonomous space systems, Earth observation, satellite technologies, sustainability, and future human
                space exploration.</p>
            </div>
          </div>
          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
            <div class="timeline-item">
              <h4>Develop the SHE ORBITS Academy</h4>
              <p class="text-dark text-opacity-70">Build a comprehensive learning ecosystem offering professional
                courses, certifications, research training, and specialized programs across every major space
                discipline.</p>
            </div>
          </div>
          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="250" data-aos-duration="1000">
            <div class="timeline-item">
              <h4>Launch Space Missions &amp; Engineering Projects</h4>
              <p class="text-dark text-opacity-70">Design and develop CubeSat missions, satellite technologies, mission
                concepts, robotics projects, and future space engineering initiatives through collaborative research and
                innovation.</p>
            </div>
          </div>
          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300" data-aos-duration="1000">
            <div class="timeline-item">
              <h4>Build Global Partnerships</h4>
              <p class="text-dark text-opacity-70">Strengthen collaborations with universities, research institutions,
                government agencies, industry leaders, and international organizations to accelerate scientific
                advancement and educational impact.</p>
            </div>
          </div>
          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="350" data-aos-duration="1000">
            <div class="timeline-item">
              <h4>Empower the Next Generation</h4>
              <p class="text-dark text-opacity-70">Provide accessible pathways through education, mentorship, leadership
                programs, ambassador initiatives, innovation challenges, scholarships and career development
                opportunities for future space professionals worldwide.</p>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-8" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
          <div class="col-md-4 col-lg-2">
            <div class="timeline-item h-100">
              <h5 class="mb-3">2025</h5>
              <ul class="mb-0 ps-3 text-dark text-opacity-70">
                <li>Launch SHE ORBITS Academy</li>
                <li>Expand flagship programs</li>
                <li>Strengthen international partnerships</li>
              </ul>
            </div>
          </div>
          <div class="col-md-4 col-lg-2">
            <div class="timeline-item h-100">
              <h5 class="mb-3">2026</h5>
              <ul class="mb-0 ps-3 text-dark text-opacity-70">
                <li>World Space Week</li>
                <li>NASA Space Apps</li>
                <li>Research publications</li>
                <li>Ambassador Program</li>
              </ul>
            </div>
          </div>
          <div class="col-md-4 col-lg-2">
            <div class="timeline-item h-100">
              <h5 class="mb-3">2027</h5>
              <ul class="mb-0 ps-3 text-dark text-opacity-70">
                <li>CubeSat mission development</li>
                <li>AI research initiatives</li>
                <li>Innovation Lab expansion</li>
              </ul>
            </div>
          </div>
          <div class="col-md-4 col-lg-2">
            <div class="timeline-item h-100">
              <h5 class="mb-3">2028</h5>
              <ul class="mb-0 ps-3 text-dark text-opacity-70">
                <li>Global research network</li>
                <li>International conferences</li>
                <li>Industry partnerships</li>
              </ul>
            </div>
          </div>
          <div class="col-md-4 col-lg-2">
            <div class="timeline-item h-100">
              <h5 class="mb-3">2029</h5>
              <ul class="mb-0 ps-3 text-dark text-opacity-70">
                <li>Space technology incubator</li>
                <li>International fellowship programs</li>
              </ul>
            </div>
          </div>
          <div class="col-md-4 col-lg-2">
            <div class="timeline-item h-100">
              <h5 class="mb-3">2030</h5>
              <ul class="mb-0 ps-3 text-dark text-opacity-70">
                <li>Global center for space education and innovation</li>
                <li>Advanced research programs</li>
                <li>International mission collaborations</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-8" data-aos="fade-up" data-aos-delay="150" data-aos-duration="1000">
          <div class="col-md-6 col-lg-4">
            <p class="mb-2 fw-semibold">Global Community</p>
            <div class="progress" role="progressbar" aria-label="Global Community progress" aria-valuenow="80"
              aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
              <div class="progress-bar bg-primary" style="width: 80%"></div>
            </div>
            <p class="small text-dark text-opacity-70 mt-1 mb-0">80%</p>
          </div>
          <div class="col-md-6 col-lg-4">
            <p class="mb-2 fw-semibold">Educational Programs</p>
            <div class="progress" role="progressbar" aria-label="Educational Programs progress" aria-valuenow="70"
              aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
              <div class="progress-bar bg-primary" style="width: 70%"></div>
            </div>
            <p class="small text-dark text-opacity-70 mt-1 mb-0">70%</p>
          </div>
          <div class="col-md-6 col-lg-4">
            <p class="mb-2 fw-semibold">Research Projects</p>
            <div class="progress" role="progressbar" aria-label="Research Projects progress" aria-valuenow="60"
              aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
              <div class="progress-bar bg-primary" style="width: 60%"></div>
            </div>
            <p class="small text-dark text-opacity-70 mt-1 mb-0">60%</p>
          </div>
          <div class="col-md-6 col-lg-4">
            <p class="mb-2 fw-semibold">International Partners</p>
            <div class="progress" role="progressbar" aria-label="International Partners progress" aria-valuenow="50"
              aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
              <div class="progress-bar bg-primary" style="width: 50%"></div>
            </div>
            <p class="small text-dark text-opacity-70 mt-1 mb-0">50%</p>
          </div>
          <div class="col-md-6 col-lg-4">
            <p class="mb-2 fw-semibold">Space Missions</p>
            <div class="progress" role="progressbar" aria-label="Space Missions progress" aria-valuenow="30"
              aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
              <div class="progress-bar bg-primary" style="width: 30%"></div>
            </div>
            <p class="small text-dark text-opacity-70 mt-1 mb-0">30%</p>
          </div>
        </div>

        <div class="mission-card bg-white" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
          <div class="text-center">
            <h3 class="mb-4">Our Vision for 2030</h3>
            <p class="fs-5 text-dark mb-0">
              By 2030, SHE ORBITS aims to be recognized as a leading global space company advancing space industry,
              space missions, research, innovation, and international collaboration, while empowering the next
              generation of scientists, engineers, entrepreneurs, and leaders shaping humanity's future in space.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Professional Footer -->
  

  <div class="get-template hstack gap-2">
    
  </div>

  
  
  
  
  
  
  

  


</BaseLayout>

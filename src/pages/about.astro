---
import ServicesGrid from '../components/ServicesGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
---
<BaseLayout title={"SHE ORBITS - About Us | empowering women in Space & STEM"} description={""} bodyClass="page-about" fluidCursor>


  <!-- Header -->
  

  <!--  Page Wrapper -->
  <div class="page-wrapper overflow-hidden">

    <!--  Banner Section -->
    <PageBanner title={"About SHE ORBITS"} video="/assets/videos/about-banner.mp4" leadCol="4" leadOpacity="70" sectionClass="overflow-hidden">Dedicated to <span class="text-primary">empowering women globally</span> to lead in space industry, technology, engineering, and innovation</PageBanner>

    <!--  About Content Section -->
    <section class="about-content py-5 py-lg-11 py-xl-12">
      <div class="container">
        <div class="d-flex flex-column gap-5 gap-xl-11 gap-xxl-12">
          <div class="row gap-4 gap-lg-0">
            <div class="col-lg-4">
              <h2 class="fs-13 mb-0" data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000">SHE ORBITS.
              </h2>
            </div>
            <div class="col-lg-8">
              <div class="d-flex flex-column gap-4 gap-lg-5" data-aos="fade-up" data-aos-delay="200"
                data-aos-duration="1000">
                <p class="mb-0 fs-5 text-dark">
                  SHE ORBITS is a multidisciplinary Space &amp; STEM global company to empower females in all space
                  sectors to make Space Industry accessible, inclusive, and inspiring for learners across backgrounds.
                  We aim to build a global community of future space scientists, engineers, researchers, and thinkers by
                  combining foundational theory, real-world context, and interdisciplinary exploration. SHE ORBITS was
                  established in September 2025.
                </p>
                <p class="mb-0 fs-5 text-dark">
                  Founded by E&amp;D TSI Astronaut Candidate and Aerospace Engineer Asmaa Hossam, our organisation
                  connects women with world-class female leaders through workshops, mentorships, programs, competitions,
                  real-world research experiences and so more.
                </p>
                <p class="mb-0 fs-5 text-dark">
                  Through more than 30 space and STEM sectors, SHE ORBITS introduces learners to aerospace engineering,
                  space medicine, AI and data science, sustainability, policy, communications, business, arts, and
                  future human space fields. These pathways help every participant see where their strengths can
                  contribute to the global space ecosystem.
                </p>
                <p class="mb-0 fs-5 text-dark">
                  We envision a future where women are equally represented at every level of the global space
                  industry—as pioneers, innovators, entrepreneurs, researchers, executives, and explorers. Through
                  pioneering programs and initiatives, strategic partnerships, research, education, and workforce
                  development, SHE ORBITS strives to cultivate the next generation of scientists, engineers,
                  entrepreneurs, and industry leaders.
                </p>
              </div>
            </div>
          </div>
          <div class="row gx-xl-5">
            <div class="col-md-6 col-lg-3 mb-8 mb-lg-0">
              <div class="d-flex flex-column gap-7" data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
                <h2 class="mb-0 fs-13 pb-7 border-bottom"><span class="count" data-target="1500">1000</span>+</h2>
                <div class="d-flex flex-column gap-3">
                  <h4 class="mb-0">Women Engaged Globally</h4>
                  <p class="mb-0">Our company has empowered over 1,500 women worldwide through comprehensive space and
                    STEM programs.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-8 mb-lg-0">
              <div class="d-flex flex-column gap-7" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
                <h2 class="mb-0 fs-13 pb-7 border-bottom"><span class="count" data-target="150">150</span>+</h2>
                <div class="d-flex flex-column gap-3">
                  <h4 class="mb-0">Workshops Conducted</h4>
                  <p class="mb-0">Over 150 interactive workshops teaching essential space skills in a fun and accessible
                    way.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-8 mb-lg-0">
              <div class="d-flex flex-column gap-7" data-aos="fade-up" data-aos-delay="300" data-aos-duration="1000">
                <h2 class="mb-0 fs-13 pb-7 border-bottom"><span class="count" data-target="7">6</span></h2>
                <div class="d-flex flex-column gap-3">
                  <h4 class="mb-0">Continents Reached</h4>
                  <p class="mb-0">Our programs span 6 continents with 10+ international partnerships, creating a global
                    network of future female space leaders.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-8 mb-lg-0">
              <div class="d-flex flex-column gap-7" data-aos="fade-up" data-aos-delay="400" data-aos-duration="1000">
                <h2 class="mb-0 fs-13 pb-7 border-bottom"><span class="count" data-target="30">30</span>+</h2>
                <div class="d-flex flex-column gap-3">
                  <h4 class="mb-0">Space & STEM Sectors</h4>
                  <p class="mb-0">Participants explore interdisciplinary fields from engineering and medicine to policy,
                    business, arts, and future human space systems.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--  About Img Section -->
    <section class="about-img services-section">
      <img src="/assets/images/38.webp" alt="SHE ORBITS space medicine and research learning environment"
        class="w-100 object-fit-cover">
      <div class="container py-5 py-lg-8">
        <div class="row justify-content-between align-items-end gap-5 gap-xl-0 mb-6" data-aos="fade-up" data-aos-duration="800">
          <div class="col-xl-4">
            <h2 class="mb-0">Our Services</h2>
          </div>
          <div class="col-xl-7">
            <p class="fs-5 text-dark mb-0">SHE ORBITS delivers world-class educational, research, and innovation services that empower the next generation of space professionals while supporting organizations, institutions, and communities through international collaboration and cutting-edge space initiatives.</p>
          </div>
        </div>
        <ServicesGrid />
      </div>
    </section>

  </div>

  <!-- Professional Futuristic Footer -->
  


  <div class="get-template hstack gap-2">
    
  </div>

  
  
  
  
  
  <!-- solar icons -->
  
  

  


</BaseLayout>

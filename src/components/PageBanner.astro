---
import Icon from './Icon.astro';
interface Props {
  title: string;
  video: string;
  ctaHref?: string;
  ctaLabel?: string;
  leadCol?: '4' | '6';
  leadOpacity?: '70' | '90';
  padClass?: string;
  copyClass?: string;
  sectionClass?: string;
}
const { title, video, ctaHref, ctaLabel, leadCol = '6', leadOpacity = '90', padClass = 'pb-5 pb-xl-10', copyClass = '', sectionClass = '' } = Astro.props;
const Cta = ctaHref ? 'a' : 'div';
---
<section class:list={['banner-section position-relative d-flex align-items-end min-vh-100', sectionClass]}>
  <a href="/" class="banner-hero-logo" aria-label="SHE ORBITS home">
    <img src="/assets/images/logos/logo-light.svg?v=she-orbits-8" alt="SHE ORBITS" width="112" height="34" />
  </a>
  <video class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" style="z-index: 0;" autoplay muted loop playsinline>
    <source src={video} type="video/mp4" />
  </video>
  <div class="container">
    <div class:list={['d-flex flex-column gap-4 position-relative z-1', padClass]}>
      <div class="row align-items-center">
        <div class={`col-xl-${leadCol}`}>
          <div class:list={['d-flex align-items-center gap-4', copyClass]} data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000">
            <img src="/assets/images/svgs/primary-leaf.svg" alt="" class="img-fluid animate-spin" />
            <p class:list={['mb-0 text-white fs-5', `text-opacity-${leadOpacity}`]}><slot /></p>
          </div>
        </div>
      </div>
      <div class="d-flex align-items-end gap-3 flex-wrap" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">
        <h1 class="mb-0 fs-16 text-white lh-1" set:html={title} />
        <Cta href={ctaHref} class="p-1 ps-7 bg-primary rounded-pill" aria-label={ctaLabel}>
          <span class="bg-white round-52 rounded-circle d-flex align-items-center justify-content-center">
            <Icon name="lucide:arrow-up-right" class="fs-8 text-dark" />
          </span>
        </Cta>
      </div>
    </div>
  </div>
</section>
